# LLM
OPENAI_KEY="lm-studio"
OPENAI_ENDPOINT="http://127.0.0.1:1234/v1"
CUSTOM_MODEL="your-loaded-model-id"
CONTEXT_SIZE="128000"

# The web UI fetches available chat models from OPENAI_ENDPOINT on startup.
# Select a model per investigation; CUSTOM_MODEL is the default selection.
# For another OpenAI-compatible provider, replace OPENAI_KEY, OPENAI_ENDPOINT,
# and CUSTOM_MODEL with that provider's values.

# Search provider (direct SearXNG avoids running a second LLM pipeline)
SEARCH_PROVIDER="searxng"
SEARXNG_BASE_URL="http://localhost:8080"
SEARCH_LANGUAGE="ja-JP"

# Optional Vane / Perplexica provider
# SEARCH_PROVIDER="vane"
# PERPLEXICA_BASE_URL="http://localhost:3000"
# PERPLEXICA_PROVIDER_ID="YOUR_PROVIDER_UUID"
# PERPLEXICA_CHAT_MODEL="YOUR_CHAT_MODEL_KEY"
# PERPLEXICA_EMBEDDING_PROVIDER_ID="YOUR_PROVIDER_UUID"
# PERPLEXICA_EMBEDDING_MODEL="YOUR_EMBEDDING_MODEL_KEY"
# PERPLEXICA_OPTIMIZATION_MODE="speed"

SEARCH_CONCURRENCY="2"

# If you want to use fireworks.ai's DeepSeek R1 model:
# FIREWORKS_KEY="YOUR_KEY"
